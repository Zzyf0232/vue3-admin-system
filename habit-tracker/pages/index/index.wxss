/* ===== index.wxss —— 页面样式 ===== */
.page { padding: 20rpx 24rpx 60rpx; }

.hero { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 24rpx; }
.date-block { background: #FFFFFF; border: 1rpx solid #DDE7E1; border-radius: 24rpx; padding: 34rpx 30rpx; display: flex; align-items: center; gap: 30rpx; box-shadow: 0 8rpx 28rpx rgba(31,60,43,0.06); }
.date-num { font-size: 96rpx; font-weight: 900; line-height: 1; color: #2E7D5B; min-width: 130rpx; text-align: center; font-family: serif; }
.date-title { font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; font-family: serif; }
.date-sub { margin-top: 8rpx; color: #5C6B64; font-size: 26rpx; }
.date-sub .b { color: #22312B; font-weight: 700; }
.date-hint { margin-top: 12rpx; font-size: 22rpx; color: #8A9A91; }

.stats { display: flex; gap: 14rpx; }
.stat { flex: 1; background: #FFFFFF; border: 1rpx solid #DDE7E1; border-radius: 20rpx; padding: 22rpx 10rpx 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; text-align: center; box-shadow: 0 8rpx 28rpx rgba(31,60,43,0.06); }
.stat-label { font-size: 22rpx; color: #5C6B64; }
.stat-value { font-size: 40rpx; font-weight: 700; line-height: 1.15; }
.stat-value.accent { color: #B4631D; }
.stat-value .unit { font-size: 22rpx; font-weight: 600; color: #5C6B64; }
.stat-foot { font-size: 20rpx; color: #8A9A91; }

.ring { position: relative; width: 118rpx; height: 118rpx; border-radius: 50%; }
.ring-inner { position: absolute; left: 13rpx; top: 13rpx; right: 13rpx; bottom: 13rpx; background: #FFFFFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.ring-txt { font-size: 28rpx; font-weight: 700; color: #1E5C40; }

.section { background: #FFFFFF; border: 1rpx solid #DDE7E1; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(31,60,43,0.06); padding: 26rpx 24rpx; margin-bottom: 22rpx; }
.sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; font-family: serif; display: flex; align-items: center; }
.sec-title::before { content: ""; width: 10rpx; height: 30rpx; border-radius: 5rpx; background: #2E7D5B; margin-right: 14rpx; display: inline-block; }
.empty { padding: 44rpx 0; text-align: center; color: #8A9A91; font-size: 25rpx; }

.habit-grid { display: flex; flex-direction: column; gap: 14rpx; }
.habit-card { display: flex; align-items: center; gap: 20rpx; border: 2rpx solid #DDE7E1; border-radius: 20rpx; padding: 22rpx 22rpx; background: #F7FAF8; transition: border-color 0.18s, background 0.18s; }
.card-hover { opacity: 0.86; }
.habit-card.done { background: #E3F0E8; border-color: #2E7D5B; }
.habit-icon { width: 76rpx; height: 76rpx; border-radius: 20rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.habit-icon .icon-img { width: 44rpx; height: 44rpx; }
.habit-icon.sm { width: 62rpx; height: 62rpx; border-radius: 16rpx; }
.habit-icon.sm .icon-img { width: 36rpx; height: 36rpx; }
.icon-img { display: block; }
.habit-info { flex: 1; min-width: 0; }
.habit-name { font-size: 29rpx; font-weight: 600; color: #22312B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.habit-card.done .habit-name { color: #1E5C40; }
.habit-meta { font-size: 22rpx; color: #8A9A91; margin-top: 2rpx; }

.check { width: 46rpx; height: 46rpx; border-radius: 50%; border: 3rpx solid #C6D5CD; flex: none; display: flex; align-items: center; justify-content: center; transition: background 0.2s, border-color 0.2s; }
.habit-card.done .check { background: #2E7D5B; border-color: #2E7D5B; }
.tick { width: 12rpx; height: 24rpx; border-right: 5rpx solid #FFFFFF; border-bottom: 5rpx solid #FFFFFF; transform: rotate(45deg) translate(-3rpx, -2rpx); }

.add-btn { margin-top: 18rpx; padding: 24rpx; border-radius: 20rpx; border: 2rpx dashed #B9CCC1; color: #1E5C40; font-size: 27rpx; font-weight: 600; text-align: center; transition: background 0.18s, border-color 0.18s; }

.month-nav { display: flex; align-items: center; gap: 10rpx; }
.nav-btn { width: 58rpx; height: 58rpx; border-radius: 16rpx; border: 1rpx solid #DDE7E1; background: #F7FAF8; display: flex; align-items: center; justify-content: center; color: #5C6B64; font-size: 30rpx; }
.nav-btn.dis { opacity: 0.35; }
.m-label { min-width: 160rpx; text-align: center; font-weight: 600; font-size: 27rpx; }

.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.cal-dow { text-align: center; font-size: 22rpx; color: #8A9A91; padding-bottom: 4rpx; }
.cal-dow.weekend { color: #C9A37E; }
.cal-cell { aspect-ratio: 1 / 1.05; min-height: 64rpx; border-radius: 14rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #EDF1EE; color: #8A9A91; font-size: 24rpx; font-weight: 600; line-height: 1.2; overflow: hidden; }
.cal-cell.blank { background: transparent; }
.cal-cell.r1 { background: #DFEAE2; color: #5C6B64; }
.cal-cell.r2 { background: #C6DDCC; }
.cal-cell.r3 { background: #A2CDB4; }
.cal-cell.r4 { background: #6FB592; color: #1E5C40; }
.cal-cell.r5 { background: #2E7D5B; color: #FFFFFF; }
.cal-cell.future { background: transparent; border: 1rpx dashed #DDE7E1; color: #8A9A91; }
.cal-cell.today { box-shadow: inset 0 0 0 4rpx #D97E2E; color: #B4631D; }
.cal-cell.r5.today { box-shadow: inset 0 0 0 4rpx #FFFFFF; }
.rate-bar { width: 26rpx; height: 5rpx; border-radius: 3rpx; background: rgba(46,125,91,0.55); margin-top: 3rpx; }
.cal-cell.r5 .rate-bar { background: rgba(255,255,255,0.6); }

.cal-legend { display: flex; align-items: center; gap: 8rpx; justify-content: flex-end; margin-top: 16rpx; }
.cal-legend .cell { width: 22rpx; height: 22rpx; border-radius: 6rpx; background: #EDF1EE; }
.cal-legend .cell.l1 { background: #DFEAE2; }
.cal-legend .cell.l2 { background: #C6DDCC; }
.cal-legend .cell.l3 { background: #A2CDB4; }
.cal-legend .cell.l4 { background: #6FB592; }
.cal-legend .cell.l5 { background: #2E7D5B; }
.lg-txt { font-size: 20rpx; color: #8A9A91; margin: 0 4rpx; }

.manage-list { display: flex; flex-direction: column; gap: 12rpx; }
.manage-item { display: flex; align-items: center; gap: 18rpx; border: 1rpx solid #DDE7E1; border-radius: 18rpx; padding: 18rpx 18rpx; background: #F7FAF8; }
.manage-info { flex: 1; min-width: 0; }
.manage-name { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.manage-stats { font-size: 22rpx; color: #8A9A91; margin-top: 2rpx; }
.manage-actions { display: flex; gap: 10rpx; flex: none; }
.tag-btn { padding: 10rpx 20rpx; border-radius: 12rpx; border: 1rpx solid #DDE7E1; background: #FFFFFF; color: #5C6B64; font-size: 23rpx; font-weight: 600; }
.tag-btn.danger { color: #B4483C; border-color: #E8C4BE; background: #F9E9E7; }
.tag-hover { opacity: 0.75; }

.footer { text-align: center; color: #8A9A91; font-size: 20rpx; padding: 10rpx 0 0; }

.mask { position: fixed; inset: 0; z-index: 50; background: rgba(34,49,43,0.45); display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.modal { background: #FFFFFF; border-radius: 26rpx; width: 100%; max-width: 620rpx; box-shadow: 0 24rpx 60rpx rgba(31,60,43,0.25); padding: 36rpx 34rpx; }
.modal-title { font-size: 34rpx; font-weight: 700; font-family: serif; margin-bottom: 26rpx; }
.field { margin-bottom: 24rpx; }
.f-label { font-size: 23rpx; font-weight: 600; color: #5C6B64; margin-bottom: 12rpx; }
.f-input { width: 100%; box-sizing: border-box; padding: 18rpx 20rpx; font-size: 28rpx; border: 2rpx solid #DDE7E1; border-radius: 16rpx; background: #F7FAF8; color: #22312B; }
.ph { color: #B7C4BC; }
.color-row { display: flex; gap: 18rpx; }
.color-opt { width: 56rpx; height: 56rpx; border-radius: 50%; border: 4rpx solid transparent; box-sizing: border-box; }
.color-opt.sel { border-color: #22312B; box-shadow: inset 0 0 0 4rpx #FFFFFF; }
.icon-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.icon-opt { width: calc((100% - 42rpx) / 4); height: 84rpx; border-radius: 16rpx; border: 2rpx solid #DDE7E1; background: #F7FAF8; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.icon-opt .icon-img { width: 48rpx; height: 48rpx; }
.icon-opt.sel { background: #E3F0E8; border-color: #2E7D5B; }
.modal-actions { display: flex; gap: 16rpx; justify-content: flex-end; margin-top: 30rpx; }
.btn { padding: 16rpx 34rpx; border-radius: 16rpx; font-size: 27rpx; font-weight: 600; }
.btn.primary { background: #2E7D5B; color: #FFFFFF; }
.btn.ghost { background: #F7FAF8; color: #5C6B64; border: 1rpx solid #DDE7E1; }

.data-actions { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.data-btn { flex: 1; background: #F7FAF8; border: 2rpx solid #DDE7E1; border-radius: 18rpx; padding: 26rpx 20rpx; display: flex; flex-direction: column; align-items: center; gap: 6rpx; transition: background 0.18s, border-color 0.18s; }
.data-btn-icon { font-size: 40rpx; line-height: 1; margin-bottom: 4rpx; }
.data-btn-text { font-size: 27rpx; font-weight: 600; color: #22312B; }
.data-btn-desc { font-size: 21rpx; color: #8A9A91; }
.data-stats { text-align: center; font-size: 22rpx; color: #8A9A91; padding: 8rpx 0; }

.f-textarea { width: 100%; box-sizing: border-box; padding: 18rpx 20rpx; font-size: 26rpx; border: 2rpx solid #DDE7E1; border-radius: 16rpx; background: #F7FAF8; color: #22312B; min-height: 180rpx; max-height: 400rpx; }
.import-tip { font-size: 22rpx; color: #B4483C; margin-top: -10rpx; margin-bottom: 4rpx; }